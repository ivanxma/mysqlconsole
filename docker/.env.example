# Default local-admin password. Change it after first login.
DBCONSOLE_LOCAL_ADMIN_PASSWORD=ChangeMe123!
# Optional OCI config fallback for Object Storage only. Instance Principal is tried first.
# Put a container-compatible config and private key under docker/oci, or set OCI_CONFIG_DIR to another directory.
# OCI_CONFIG_DIR=./oci
OCI_CONFIG_PROFILE=DEFAULT
